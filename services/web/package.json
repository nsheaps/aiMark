    "dev": "astro dev --port 4321"
  },
  "dependencies": {
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "prettier-plugin-astro": "^0.14.0"
  }
}
