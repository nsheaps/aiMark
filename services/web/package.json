{
  "name": "@aimark/web",
  "version": "0.1.0",
  "private": true,
  "description": "aimark.dev public site (Astro, served as Cloudflare Worker static assets)",
  "type": "module",
  "scripts": {
    "build": "astro build",
    "test": "true",
    "lint": "prettier --check src && astro check",
