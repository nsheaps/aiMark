---
import Layout from "../../layouts/Layout.astro";
import Term from "../../components/Term.astro";
---

<Layout
  title="Models — aiMark"
  description="Every model on aiMark with run counts and median composite scores per suite and track."
>
  <div class="container page">
    <h1>Models</h1>
    <p class="lede">
      Every <Term id="model">model</Term> the community has benchmarked, with run counts and the
      median <Term id="composite-score">composite score</Term> per <Term id="suite">suite</Term>
      and <Term id="track">track</Term>. Click a model to see its full leaderboard rows.
    </p>
    <div class="callout">
      <strong>Medians, not head-to-head results.</strong> A model's median composite folds together
      every rig, <Term id="quantization">quantization</Term>, and parameter setup the community has
      submitted — it shows what's typical, not what's possible. Scores are only comparable within
      the same suite version and track.
    </div>

    <form class="explore-controls" aria-label="Model filters">
      <fieldset class="track-toggle">
        <legend>Track</legend>
        <label><input type="radio" name="track" value="" checked /> All</label>
        <label><input type="radio" name="track" value="local" /> Local</label>
        <label><input type="radio" name="track" value="hosted" /> Hosted</label>
      </fieldset>
      <label class="control-filter">
        <span>Filter by model</span>
        <input type="search" id="model-filter" placeholder="e.g. llama3.1" autocomplete="off" />
      </label>
    </form>

    <div class="table-wrap" id="models-root" aria-live="polite">
      <div class="data-status" role="status"><p>Loading models…</p></div>
    </div>
  </div>
</Layout>

<script>
  import {
    apiGet,
    el,
    fmtScore,
    scoreGrade,
    setDataStatus,
    type ModelAggRow,
  } from "../../scripts/api";

  const root = document.getElementById("models-root") as HTMLElement;
  const form = document.querySelector<HTMLFormElement>(".explore-controls");
  const filterInput = document.getElementById("model-filter") as HTMLInputElement;

  let rows: ModelAggRow[] = [];
  let fetchFailed = false;

  function currentTrack(): string {
    const checked = form?.querySelector<HTMLInputElement>('input[name="track"]:checked');
    return checked?.value ?? "";
  }

  function render() {
    if (fetchFailed) {
      setDataStatus(
        root,
        "API unreachable",
        "We couldn't load the model index — check your connection or try again shortly.",
      );
      return;
    }
    const needle = filterInput.value.trim().toLowerCase();
    const track = currentTrack();
    const visible = rows
      .filter((r) => !track || r.track === track)
      .filter((r) => !needle || r.model.toLowerCase().includes(needle))
      .sort((a, b) => (b.median_composite ?? -Infinity) - (a.median_composite ?? -Infinity));

    if (visible.length === 0) {
      setDataStatus(
        root,
        rows.length === 0 ? "No models benchmarked yet" : "No models match that filter",
        rows.length === 0
          ? "Run a suite and submit a score — your model claims the first row."
          : "Try a shorter model name, or clear the filter.",
      );
      return;
    }

    const headRow = el(
      "tr",
      {},
      el("th", { scope: "col" }, "Model"),
      el("th", { scope: "col" }, "Suite"),
      el("th", { scope: "col" }, "Track"),
      el("th", { scope: "col", class: "num" }, "Runs"),
      el("th", { scope: "col", class: "num" }, "Median aiMark Score"),
    );
    const tbody = el("tbody");
    for (const row of visible) {
      const boardHref =
        `/leaderboard/${encodeURIComponent(row.suite)}/${encodeURIComponent(String(row.version))}/` +
        `?model=${encodeURIComponent(row.model)}`;
      tbody.append(
        el(
          "tr",
          {},
          el("td", {}, el("a", { href: boardHref }, row.model)),
          el("td", {}, `${row.suite} v${row.version}`),
          el("td", {}, row.track),
          el("td", { class: "num" }, String(row.n)),
          el(
            "td",
            { class: `num ${scoreGrade(row.median_composite)}` },
            fmtScore(row.median_composite),
          ),
        ),
      );
    }
    root.replaceChildren(el("table", {}, el("thead", {}, headRow), tbody));
  }

  async function load() {
    setDataStatus(root, "Loading models…");
    const data = await apiGet<{ models: ModelAggRow[] }>("/v1/models");
    fetchFailed = !data || !Array.isArray(data.models);
    rows = fetchFailed ? [] : data!.models;
    render();
  }

  form?.addEventListener("change", (e) => {
    if (e.target !== filterInput) render();
  });
  filterInput.addEventListener("input", () => render());
  form?.addEventListener("submit", (e) => e.preventDefault());

  load();
</script>

<style>
  .explore-controls {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin: 1.5rem 0 1rem;
  }

  .track-toggle {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.35rem 0.9rem 0.5rem;
    display: flex;
    gap: 1rem;
    margin: 0;
  }

  .track-toggle legend {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    padding: 0 0.3rem;
  }

  .track-toggle label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.92rem;
  }

  .control-filter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.92rem;
    margin-left: auto;
  }

  .control-filter span {
    color: var(--muted);
  }

  @media (max-width: 720px) {
    .control-filter {
      margin-left: 0;
      width: 100%;
    }

    .control-filter input {
      flex: 1;
    }
  }
</style>
