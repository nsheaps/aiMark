{
  "name": "@aimark/api",
  "version": "0.1.0",
  "private": true,
  "description": "aiMark submission + leaderboard API (Hono, deployed to Cloudflare Workers)",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "bun test",
    "lint": "prettier --check src test && tsc --noEmit",
    "format": "prettier --write src test && tsc --noEmit",
    "dev": "bun run --watch entrypoints/bun.ts"
  },
  "dependencies": {
    "@aimark/schema": "workspace:*",
    "@aimark/scoring": "workspace:*",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
