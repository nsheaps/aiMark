{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aimark.dev/schemas/suite-manifest.v1.json",
  "title": "AimarkSuiteManifestV1",
  "description": "A frozen benchmark suite definition. Weights, reference baselines, prompts, and protocol are data — bumping any of them requires a new suite version (new leaderboard).",
  "type": "object",
  "required": ["id", "version", "status", "title", "tracks", "protocol", "tasks", "scoring"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "integer", "minimum": 1 },
    "status": {
      "type": "string",
      "enum": ["draft", "frozen", "retired"],
      "description": "Only frozen suites produce comparable leaderboard scores"
    },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "tracks": {
      "type": "array",
      "items": { "type": "string", "enum": ["local", "hosted"] },
      "minItems": 1
    },
    "reference": {
      "type": "object",
      "description": "Provenance of the reference baseline that anchors this suite's 1000-point scale",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "protocol": {
      "type": "object",
      "required": ["warmup_requests", "repetitions", "request_timeout_ms", "streaming", "decoding"],
      "additionalProperties": false,
      "properties": {
        "warmup_requests": { "type": "integer", "minimum": 0 },
        "repetitions": { "type": "integer", "minimum": 1 },
        "request_timeout_ms": { "type": "integer", "minimum": 1 },
        "streaming": { "type": "boolean" },
        "concurrency_levels": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "description": "Marathon-style suites run the task set at each level"
        },
        "decoding": {
          "type": "object",
          "required": ["temperature", "max_tokens"],
          "additionalProperties": false,
          "properties": {
            "temperature": { "type": "number" },
            "max_tokens": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "prompt"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "prompt": { "type": "string" },
          "system": { "type": "string" },
          "grading": {
            "type": "object",
            "description": "Objective grading spec (quality suites). Absent for pure-latency suites.",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["exact", "numeric_tolerance", "json_schema", "contains_all", "js_tests"]
              },
              "expected": { "type": ["string", "number"] },
              "tolerance": { "type": "number" },
              "schema": { "type": "object" },
              "required_substrings": { "type": "array", "items": { "type": "string" } },
              "tests": { "type": "string", "description": "JS test source for goja (Forge)" }
            }
          }
        }
      }
    },
    "scoring": {
      "type": "object",
      "required": ["composite_weights"],
      "additionalProperties": false,
      "properties": {
        "performance": { "$ref": "#/definitions/subScoreSpec" },
        "quality": { "$ref": "#/definitions/subScoreSpec" },
        "cost_efficiency": { "$ref": "#/definitions/subScoreSpec" },
        "consistency": { "$ref": "#/definitions/subScoreSpec" },
        "composite_weights": {
          "type": "object",
          "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "plausibility": {
      "type": "object",
      "description": "Hard physical bounds per metric; submissions outside are auto-flagged",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "min": { "type": "number" },
          "max": { "type": "number" }
        }
      }
    }
  },
  "definitions": {
    "subScoreSpec": {
      "type": "object",
      "required": ["metrics"],
      "additionalProperties": false,
      "properties": {
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["key", "reference", "weight"],
            "additionalProperties": false,
            "properties": {
              "key": { "type": "string" },
              "reference": { "type": "number", "exclusiveMinimum": 0 },
              "weight": { "type": "number", "exclusiveMinimum": 0 },
              "lower_is_better": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
